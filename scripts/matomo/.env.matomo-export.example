# Variaveis do export_matomo_mariadb.py (VM do Matomo).
#
# Alternativa preferida: nao definir nada disto e usar
#   --config-ini /var/www/matomo/config/config.ini.php
# para o script ler as credenciais directamente da configuracao do Matomo.
#
# Ordem de precedencia: argumentos CLI > estas variaveis > config.ini.php
#
# Usar com:  set -a; . ./.env.matomo-export; set +a

MATOMO_DB_HOST=127.0.0.1
MATOMO_DB_PORT=3306
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=
MATOMO_DB_NAME=matomo
MATOMO_DB_PREFIX=matomo_

# idsite da instancia de producao (dados.gov.pt). Confirmar com --info antes de exportar:
# o dump de desenvolvimento tem 1=dev.dados.gov.pt e 2=TST Dados Gov.
MATOMO_SITE_ID=3


# Variaveis do import_matomo_export_to_mongo.py (VM do MongoDB).
# Sao as mesmas que ../.env ja usa, repetidas aqui para referencia.
MONGODB_HOST=10.55.37.143
MONGODB_PORT=27017
