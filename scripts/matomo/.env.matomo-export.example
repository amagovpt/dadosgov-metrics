# Exemplo de configuracao do import_matomo_metrics.py.
#
# Copiar para `.env` (ao lado do script) e ajustar ao ambiente. O script le-o
# sozinho -- nao e preciso `set -a; . ./.env; set +a` -- ou entao indicar outro
# com --env-file /caminho/ambiente.env
#
# Precedencia: argumentos > ambiente ja exportado > este ficheiro > omissoes.
# O `.env` esta no .gitignore; este exemplo nao leva enderecos nem segredos.


# --------------------------------------------------------------------------- #
# MongoDB (udata.metrics) -- OBRIGATORIO
# --------------------------------------------------------------------------- #
# Corre noutra VM e muda de ambiente para ambiente, por isso nao ha valor por
# omissao no codigo: sem isto o script para com codigo 2 e explica as opcoes.
# Para importar so para o PostgreSQL, correr com --skip-mongo.

MONGODB_HOST=
MONGODB_PORT=27017

# Em alternativa ao par acima, quando ha autenticacao ou replica set
# (tem prioridade sobre MONGODB_HOST/MONGODB_PORT):
# METRICS_MONGO_URI=mongodb://utilizador:password@host1:27017,host2:27017/?replicaSet=rs0

# Base de dados e coleccao da serie diaria (omissoes: udata / metrics)
# METRICS_MONGO_DB=udata
# METRICS_MONGO_COLLECTION=metrics


# --------------------------------------------------------------------------- #
# PostgreSQL (schema metric) -- opcional
# --------------------------------------------------------------------------- #
# Corre sempre na mesma maquina que o script, e as omissoes ja apontam para a
# base de dados CSV do hydra (127.0.0.1:5434, base postgres, utilizador e
# password postgres). So descomentar se este ambiente for diferente.

# METRICS_PG_HOST=127.0.0.1
# METRICS_PG_PORT=5434
# METRICS_PG_DB=postgres
# METRICS_PG_USER=postgres
# METRICS_PG_PASSWORD=postgres

# DSN completo; tem prioridade sobre as cinco variaveis acima:
# METRICS_PG_DSN=postgresql://utilizador:password@host:5434/postgres
